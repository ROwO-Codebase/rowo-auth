{
  "name": "rowo-auth",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:main": "npm run dev -w @rowo/main",
    "dev:developers": "npm run dev -w @rowo/developers",
    "build:main": "npm run build -w @rowo/main",
    "build:developers": "npm run build -w @rowo/developers",
    "preview:main": "npm run preview -w @rowo/main",
    "preview:developers": "npm run preview -w @rowo/developers",
    "clean": "npm run clean -ws --if-present",
    "lint": "tsc -b",
    "dev:worker": "npx wrangler dev --config backend/wrangler.toml",
    "deploy:worker": "npx wrangler deploy --config backend/wrangler.toml",
    "deploy:worker:prod": "npx wrangler deploy --config backend/wrangler.toml --env production"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "typescript": "~5.8.2"
  }
}
