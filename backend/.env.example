# Copy this file to `backend/.env` and fill in real values, then export
# the variables into your shell before running `wrangler dev` or
# `wrangler deploy` so Wrangler can substitute them into wrangler.toml.
#
# PowerShell (Windows):
#   Get-Content backend/.env | ForEach-Object {
#     if ($_ -match '^\s*([^#=]+?)\s*=\s*(.+?)\s*$') {
#       [Environment]::SetEnvironmentVariable($matches[1], $matches[2], 'Process')
#     }
#   }
#   wrangler dev
#
# bash/zsh:
#   set -a; source backend/.env; set +a
#   wrangler dev

# Cloudflare account (read natively by Wrangler)
CLOUDFLARE_ACCOUNT_ID=

# D1 database IDs (substituted into wrangler.toml)
D1_DATABASE_ID_PREVIEW=
D1_DATABASE_ID_PRODUCTION=
